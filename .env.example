# 1. Supabase Cloud Database Credentials
VITE_SUPABASE_URL=https://kxsovgiapzbpxahtkbuo.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# 2. EmailJS Service Credentials (Trial Class Booking System)
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id

# 3. Analytics & Webmaster Verification (Optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GSC_VERIFICATION_ID=your_google_site_verification_token

# 4. Supabase DB Migration & Admin Setup (Used by node scripts/setup.js)
DB_PASSWORD=your_database_password
SERVICE_ROLE_KEY=your_supabase_service_role_secret
ADMIN_PASSWORD=your_admin_password
